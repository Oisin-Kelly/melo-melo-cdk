# HTTP API base URL (from cdk deploy output: api-stack-{env} ApiBaseUrl)
VITE_API_BASE_URL=https://xxxx.execute-api.eu-west-1.amazonaws.com

# Cognito (from cdk deploy outputs: auth-stack-{env} UserPoolClientId / UserPoolId)
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
VITE_AWS_REGION=eu-west-1
