{
  // The unit tests (vitest.config.ts): the app's settings plus Node and Vitest types,
  // so `tsc -b` (and so `npm run build`) type-checks them too.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
